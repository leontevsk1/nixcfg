Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("special://logo");
logo.sprite = Sprite(logo.image);
logo.angle = 0;

progress_box.original_image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.original_image);
progress_bar.base_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();

fun layout ()
  {
    local.width = Window.GetWidth();
    local.height = Window.GetHeight();

    logo.sprite.SetPosition(Window.GetX() + width / 2 - logo.image.GetWidth() / 2,
                            Window.GetY() + height * 0.40 - logo.image.GetHeight() / 2,
                            10);

    local.box_width = Math.Int(width * 0.36);
    if (box_width < 160)
      {
        box_width = 160;
      }
    local.box_height = 12;
    local.bar_width = box_width - 8;
    local.bar_height = 6;

    progress_box.image = progress_box.original_image.Scale(box_width, box_height);
    progress_box.sprite.SetImage(progress_box.image);
    progress_box.x = Window.GetX() + width / 2 - box_width / 2;
    progress_box.y = Window.GetY() + height * 0.78 - box_height / 2;
    progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 5);

    progress_bar.original_image = progress_bar.base_image.Scale(bar_width, bar_height);
    progress_bar.x = progress_box.x + 4;
    progress_bar.y = progress_box.y + (box_height - bar_height) / 2;
    progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 6);
    progress_bar.sprite.SetImage(progress_bar.original_image.Scale(1, bar_height));
  }

layout();

fun refresh_callback ()
  {
    logo.angle += 0.04;
    local.opacity = 0.72 + 0.28 * (Math.Cos(logo.angle) + 1) / 2;
    logo.sprite.SetOpacity(opacity);
  }

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback (duration, progress)
  {
    local.width = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (width < 1)
      width = 1;
    progress_bar.sprite.SetImage(progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight()));
  }

Plymouth.SetBootProgressFunction(progress_callback);

fun quit_callback ()
  {
    logo.sprite.SetOpacity(1);
    progress_bar.sprite.SetImage(progress_bar.original_image);
  }

Plymouth.SetQuitFunction(quit_callback);

fun display_normal_callback ()
  {
    logo.sprite.SetOpacity(1);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);

message_sprite = Sprite();
message_sprite.SetPosition(Window.GetX() + 24, Window.GetY() + 24, 100);

fun display_message_callback (text)
  {
    message_sprite.SetImage(Image.Text(text, 0.80, 0.85, 1.0));
  }

fun hide_message_callback (text)
  {
    message_sprite.SetImage(Image.Text("", 0.0, 0.0, 0.0));
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
